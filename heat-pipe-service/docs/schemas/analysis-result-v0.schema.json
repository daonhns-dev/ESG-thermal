{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daonhns:schema:thermal-analysis-result:0.1.0",
  "title": "DaonH&S Thermal Anomaly Analysis Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "monitoring_data_id",
    "status",
    "success",
    "completed_at",
    "processing",
    "candidate_count",
    "candidates",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "job_id":{"type": "string", "pattern": "^JOB-[0-9]{8}-[0-9]{6}$"},
    "monitoring_data_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["SUCCEEDED", "FAILED"] },
    "success": { "type": "boolean" },
    "completed_at": { "type": "string", "format": "date-time" },
    "processing": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/processing" }
      ]
    },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/message" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "success": { "const": true } }, "required": ["success"] },
      "then": {
        "properties": {
          "status": { "const": "SUCCEEDED" },
          "processing": { "$ref": "#/$defs/processing" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "success": { "const": false } }, "required": ["success"] },
      "then": {
        "properties": {
          "status": { "const": "FAILED" },
          "processing": { "type": "null" },
          "candidate_count": { "const": 0 },
          "candidates": { "maxItems": 0 },
          "error": { "$ref": "#/$defs/message" }
        }
      }
    }
  ],
  "$defs": {
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "frame_range", "analysis_roi", "algorithms", "parameters", "elapsed_seconds"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["att_file_name", "atg_file_name"],
          "properties": {
            "att_file_name": { "type": "string", "minLength": 1 },
            "atg_file_name": { "type": "string", "minLength": 1 }
          }
        },
        "frame_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end_exclusive", "stride", "total_att_frames", "total_atg_records", "processed_frame_count"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end_exclusive": { "type": "integer", "minimum": 1 },
            "stride": { "type": "integer", "minimum": 1 },
            "total_att_frames": { "type": "integer", "minimum": 1 },
            "total_atg_records": { "type": "integer", "minimum": 0 },
            "processed_frame_count": { "type": "integer", "minimum": 0 }
          }
        },
        "analysis_roi": { "$ref": "#/$defs/roi" },
        "algorithms": { "type": "array", "items": { "type": "string" } },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score_threshold", "min_area_px", "min_track_frames", "merge_iou_threshold"],
          "properties": {
            "score_threshold": { "type": "number" },
            "min_area_px": { "type": "integer", "minimum": 1 },
            "min_track_frames": { "type": "integer", "minimum": 1 },
            "merge_iou_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "elapsed_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "rank", "representative_frame", "captured_at", "gps",
        "analysis_roi", "candidate_bbox", "temperature_c", "evidence", "result_image"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^JOB-[0-9]{8}-[0-9]{6}-CAND-[0-9]{4}$" },
        "rank": { "type": "integer", "minimum": 1 },
        "representative_frame": { "type": "integer", "minimum": 0 },
        "captured_at": {"oneOf":[{"type":"string", "format": "date-time"}, {"type": "null"}]},
        "gps": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
              }
            }
          ]
        },
        "analysis_roi": { "$ref": "#/$defs/roi" },
        "candidate_bbox": { "$ref": "#/$defs/roi" },
        "temperature_c": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "mean", "maximum", "background_median", "delta_from_background"],
          "properties": {
            "minimum": { "type": "number" },
            "mean": { "type": "number" },
            "maximum": { "type": "number" },
            "background_median": { "type": "number" },
            "delta_from_background": { "type": "number" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithms", "max_anomaly_score", "mean_anomaly_score", "persistence_score", "tracked_frame_count", "track_start_frame", "track_end_frame", "likely_ground_fixed"],
          "properties": {
            "algorithms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "max_anomaly_score": { "type": "number" },
            "mean_anomaly_score": { "type": "number" },
            "persistence_score": { "type": "number" },
            "tracked_frame_count": { "type": "integer", "minimum": 1 },
            "track_start_frame": { "type": "integer", "minimum": 0 },
            "track_end_frame": { "type": "integer", "minimum": 0 },
            "likely_ground_fixed": { "type": "boolean" }
          }
        },
        "result_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "width", "height", "path", "grid"],
          "properties": {
            "format": { "const": "PNG" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "path": { "type": "string", "minLength": 1 },
            "grid": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rows", "columns"],
              "properties": {
                "rows": { "const": 2 },
                "columns": { "const": 3 }
              }
            }
          }
        }
      }
    }
  }
}
