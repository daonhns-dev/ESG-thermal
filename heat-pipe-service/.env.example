# Export these variables in your shell or pass an env file to the process.
# Set a private key before calling protected APIs.
HEATPIPE_API_TOKEN=
HEATPIPE_JOB_DB_PATH=data/jobs.sqlite3
HEATPIPE_STORAGE=local
HEATPIPE_STORAGE_ROOT=data/objects
HEATPIPE_WORK_ROOT=data/work
HEATPIPE_ANALYSIS_DEVICE=cpu
# Comma-separated HTTPS hostnames allowed for ATT/ATG source URLs.
HEATPIPE_ALLOWED_SOURCE_HOSTS=
# Docker Compose binds only to localhost by default. Set the host explicitly behind HTTPS in a test environment.
HEATPIPE_BIND_HOST=127.0.0.1
HEATPIPE_HTTP_PORT=18001
