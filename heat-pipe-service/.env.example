# Export these variables in your shell or pass an env file to the process.
# Set a private key before calling protected APIs.
HEATPIPE_API_TOKEN=
HEATPIPE_JOB_DB_PATH=data/jobs.sqlite3
HEATPIPE_STORAGE=local
HEATPIPE_STORAGE_ROOT=data/objects
HEATPIPE_WORK_ROOT=data/work
# Optional att.path/atg.path support for a process launched directly in a shell.
# Base Compose does NOT import this variable. Enable compose.shared-input.yaml instead.
# Provision the shared-root marker only after verifying the external disk mount.
HEATPIPE_SHARED_INPUT_ROOT=
# Proposed server directories; only set after backup and migration, never before.
# HEATPIPE_SHARED_INPUT_HOST_ROOT=/data/data/portal/raw
# HEATPIPE_EXTERNAL_ANALYSIS_ROOT=/data/data/analysis
HEATPIPE_ANALYSIS_DEVICE=cpu
# Comma-separated hostnames (no scheme, path, port, or query) of Presigned HTTPS ATT/ATG URLs.
# For the final deployment, use the VTI portal HTTPS gateway hostname once supplied.
HEATPIPE_ALLOWED_SOURCE_HOSTS=
# Final shared-Docker-network deployment only: internal MinIO hostnames or hostname:port pairs allowed over HTTP.
# Preserve any existing entries and add portal-minio:9000 for the VTI portal deployment.
HEATPIPE_ALLOWED_INTERNAL_HTTP_HOSTS=
# Docker Compose binds only to localhost by default. Set the host explicitly behind HTTPS in a test environment.
HEATPIPE_BIND_HOST=127.0.0.1
HEATPIPE_HTTP_PORT=18001
